//  3. Webアプリを再デプロイする（デプロイを管理 → 既存のデプロイを編集 → 新バージョン）
//※実際の値を書いた secret.gs はリポジトリにコミットしないこと（.gitignore 済み）
const SEC ={
  PASSWORD: 'xxxxxxxx'   //アップロード・OCR時に照合するパスワード
}
